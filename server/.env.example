# Environment Variables for Charms Café API
# Copy this file to .env and fill in the values

# Prisma / SQLite database path
DATABASE_URL="file:./charms-dev.db"

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters
JWT_SECRET="REPLACE_ME_WITH_A_RANDOM_64_CHAR_HEX_STRING"

# Admin user to seed (npm run seed:admin)
ADMIN_SEED_EMAIL="admin@charmscafe.in"
ADMIN_SEED_PASSWORD="REPLACE_ME_STRONG_PASSWORD"

# Express server port
PORT=3001

# Node environment
NODE_ENV="development"

# Frontend origin for CORS (Vite dev server)
FRONTEND_ORIGIN="http://localhost:5173"
